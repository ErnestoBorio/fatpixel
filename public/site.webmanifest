{
  "name": "Fatpixel - Pixel art editor",
  "short_name": "Fatpixel",
  "description": "Web-based pixel art editor for old school graphics. Edit sprites and charsets with different palettes, bpp and pixel aspect ratios. Import and export to raw data and .png",
